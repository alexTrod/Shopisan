{
  "cli": {
    "version": ">= 12.5.0",
    "appVersionSource": "remote"
  },
    "build": {
      "development": {
        "distribution": "internal",
        "android": {
          "buildType": "apk"
        },
        "env": {
          "LOG_LEVEL": "debug",
          "ENABLE_LOGGING": "true"
        }
      },
      "preview": {
        "android": {
           "gradleCommand": ":app:assembleDebug",
          "buildType": "apk"
        },
        "env": {
          "LOG_LEVEL": "info",
          "ENABLE_LOGGING": "true"
        }
      },
      "preview2": {
        "android": {
          "gradleCommand": ":app:assembleRelease"
        },
        "env": {
          "LOG_LEVEL": "warn",
          "ENABLE_LOGGING": "true"
        }
      },
      "preview3": {
        "developmentClient": true,
        "env": {
          "LOG_LEVEL": "debug",
          "ENABLE_LOGGING": "true"
        }
      },
      "preview4": {
        "distribution": "internal",
        "env": {
          "LOG_LEVEL": "info",
          "ENABLE_LOGGING": "true"
        }
      },
      "production": {
        "android": {
          "gradleCommand": ":app:bundleRelease",
          "buildType": "aab"
        },
        "ios": {
          "buildConfiguration": "Release"
        },
        "env": {
          "LOG_LEVEL": "error",
          "ENABLE_LOGGING": "false"
        }
      }
    }
  
  
}
