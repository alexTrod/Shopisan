{
  "cli": {
    "version": ">= 12.5.0",
    "appVersionSource": "remote"
  },
    "build": {
      "development": {
        "distribution": "internal",
        "android": {
          "buildType": "apk"
        }
      },
      "preview": {
        "android": {
           "gradleCommand": ":app:assembleDebug",
          "buildType": "apk"
        }
      },
      "preview2": {
        "android": {
          "gradleCommand": ":app:assembleRelease",
          "buildType": "apk"
        }
      },
      "preview3": {
        "developmentClient": true
      },
      "preview4": {
        "distribution": "internal"
      },
      "production": {
        "android": {
          "buildType": "apk"
        }
      }
    }
  
  
}
