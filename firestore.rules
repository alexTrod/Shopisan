rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function hasUserDoc() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // The app writes is_admin, not role. The previous rules checked `role`,
    // a field that is never written, so every admin branch was dead.
    //
    // The `admin` custom claim is the admin-panel identity (set once via
    // scripts/set-admin-claim.js); it is checked first because it needs no
    // document read. The is_admin doc field is kept as the legacy path.
    function isAdmin() {
      return signedIn() &&
        (request.auth.token.get('admin', false) == true ||
         (hasUserDoc() && userDoc().is_admin == true));
    }

    // Only store owner accounts may create stores and posts. "merchant" is the
    // pre-migration value and is accepted until old app builds age out; drop it
    // once traffic on those builds stops (see scripts/migrate-user-types.js).
    function isStoreOwner() {
      return signedIn() && hasUserDoc() &&
        (userDoc().userType == 'owner' || userDoc().userType == 'merchant');
    }

    // Users collection
    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());

      allow create: if signedIn() && request.auth.uid == userId;

      // Users may edit their own profile but NOT their privileged fields.
      // Without this, any shopper could promote themselves to owner with a
      // single updateDoc call and the account type would mean nothing.
      //
      // Admins may update any user document: the admin panel toggles
      // is_active/is_validated and clears profile photo fields during
      // moderation.
      //
      // Read through get(key, default): pre-migration documents have no
      // signupIntent, and a direct .signupIntent lookup on a missing key
      // evaluates to an error, which would deny every profile update those
      // users make (including the email sync in fetchUserData).
      allow update: if signedIn() && resource != null
        && (isAdmin()
            || (request.auth.uid == userId
                && request.resource.data.get('userType', null) == resource.data.get('userType', null)
                && request.resource.data.get('is_admin', false) == resource.data.get('is_admin', false)
                && request.resource.data.get('signupIntent', null) == resource.data.get('signupIntent', null)));

      // Self-delete, or admin moderation delete. Full account removal
      // (Auth user + owned data) still goes through the adminDeleteUser
      // callable; this only covers the Firestore document.
      allow delete: if signedIn() && (request.auth.uid == userId || isAdmin());
    }

    // Stores - anyone can read, only store owners can create.
    //
    // Stores are live the moment they are created; there is no approval gate.
    // is_verified (the public badge) and is_suspended (abuse takedown) are
    // server-owned: only an admin or the Admin SDK may set them. is_validated
    // is frozen on update too, because app builds released before this change
    // still filter their store list on it -- clearing it is half of a takedown,
    // so an owner who could rewrite it would un-suspend themselves on every old
    // build in the wild. It stays unconstrained on create so those same builds,
    // which send is_validated: false, can still add stores.
    //
    // Read through get(key, default) everywhere: legacy store documents have
    // none of these keys, and a direct .is_verified lookup on a missing key
    // evaluates to an error, which would deny every edit those owners make.
    match /stores/{storeId} {
      // status is the moderation field: 'pending' | 'approved'. It is
      // server-owned like is_verified/is_suspended -- owners may only create
      // stores as 'pending' (or without the field, for old app builds) and may
      // never change it; admins clear it to 'approved'. Reads are NOT gated on
      // it: pending stores stay visible in the app (flag-and-review model),
      // any hiding happens client-side. Distinct from the legacy numeric
      // storeStatus field, which the app always writes as 0.
      function moderationNeutralOnCreate() {
        return request.resource.data.get('is_verified', false) == false
            && request.resource.data.get('is_suspended', false) == false
            && request.resource.data.get('status', 'pending') == 'pending';
      }

      function moderationUnchanged() {
        return request.resource.data.get('is_verified', false) == resource.data.get('is_verified', false)
            && request.resource.data.get('is_suspended', false) == resource.data.get('is_suspended', false)
            && request.resource.data.get('is_validated', false) == resource.data.get('is_validated', false)
            && request.resource.data.get('status', '') == resource.data.get('status', '');
      }

      allow read: if true;

      allow create: if isStoreOwner()
        && request.resource.data.owner_id == request.auth.uid
        && moderationNeutralOnCreate();

      // owner_id through get(key, default) and isAdmin() first: stores seeded
      // by the catalog import have no owner_id key, and a direct lookup on a
      // missing key evaluates to an error -- which would deny admins too if it
      // short-circuited ahead of them.
      allow update: if signedIn() && resource != null
        && (isAdmin()
            || (resource.data.get('owner_id', '') == request.auth.uid && moderationUnchanged()));

      allow delete: if signedIn() && resource != null
        && (isAdmin() || resource.data.get('owner_id', '') == request.auth.uid);
    }

    // Cities collection - anyone can read, authenticated users can write
    match /cities/{cityId} {
      allow read: if true;
      allow write: if signedIn();
    }

    // Countries collection - reference data, same access shape as cities.
    // The city filter loads this before login; leaving it to the default-deny
    // fallthrough blanked the filter for every user.
    match /countries/{countryId} {
      allow read: if true;
      allow write: if signedIn();
    }

    // Categories collection - anyone can read
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if signedIn();
    }

    // Store categories collection - anyone can read
    match /store_categories/{categoryId} {
      allow read: if true;
      allow write: if signedIn();
    }

    // Ratings - anyone can read, any signed-in user (shoppers included) can rate.
    // The owner field is user_id (rules previously checked a non-existent
    // `userId`, so edit and delete always denied).
    match /ratings/{ratingId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if signedIn() && resource != null
        && resource.data.get('user_id', '') == request.auth.uid;
    }

    // Posts - anyone can read, only the owning store owner can write.
    // owner_id is denormalized onto each post because posts reference the
    // store's numeric `id` field, not its document id, so the store cannot be
    // looked up from here.
    match /posts/{postId} {
      allow read: if true;
      allow create: if isStoreOwner() && request.resource.data.owner_id == request.auth.uid;
      // isAdmin() first and owner_id through get(key, default): a direct
      // lookup on a post missing the key errors out the whole expression,
      // which locked admins out of legacy posts.
      allow update, delete: if resource != null
        && (isAdmin() || (signedIn() && resource.data.get('owner_id', '') == request.auth.uid));
    }

    // Favorites - stored in user document, handled by users rules

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
