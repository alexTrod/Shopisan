    "@react-navigation/native-stack": "^7.3.10",
    "@reduxjs/toolkit": "^2.6.1",
    "@rnmapbox/maps": "^10.1.42",
    "axios": "^1.9.0",
    "expo": "~52.0.47",
    "expo-image-picker": "~16.0.6",
    "expo-localization": "~16.0.1",
    "expo-location": "~18.0.10",
    "expo-status-bar": "~2.0.1",
