{
  "expo": {
    "name": "Shopisan_v1",
    "slug": "Shopisan_v1",
    "owner": "shopisan",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ecomerce.shopisan",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Shopisan needs your location to find nearby stores.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Shopisan needs your location to find nearby stores."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.ecomerce.shopisan",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCsGAmEtEu_aox4wHgf4GOQA2nGUgjd"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      "expo-localization",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Shopisan needs your location to find nearby stores."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "1be29bfa-371f-488c-a6df-38edc942ace8"
      }
    }
  }
}
